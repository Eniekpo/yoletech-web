{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{content/**,server/**,public/**}"
    },
    "api/blog-page.js": {
      "includeFiles": "{content/**,server/**,public/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "yolestica.com" }],
      "destination": "https://www.yolestica.com/:path*",
      "permanent": true
    },
    { "source": "/signup", "destination": "/register", "permanent": true },
    { "source": "/signup/", "destination": "/register", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "portfolio" }], "destination": "/portfolio", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "blog" }], "destination": "/blog", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "services" }], "destination": "/services", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "about" }], "destination": "/about", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "learn" }], "destination": "/learn", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "contact" }], "destination": "/contact", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "admin-dashboard" }], "destination": "/admin-dashboard", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "login" }], "destination": "/login", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "register" }], "destination": "/register", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "signup" }], "destination": "/register", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "portal" }], "destination": "/portal", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "dashboard" }], "destination": "/dashboard", "permanent": true },
    { "source": "/blog/from-housing-data-to-an-interactive-ml-app-predicting-real-estate-prices-with-python-scikit-learn-and-streamlit", "destination": "/blog/housing-price-ml-app-python-streamlit", "permanent": true },
    { "source": "/blog/thomas-edison-the-inventor-who-made-electric-lighting-practical-for-the-modern-world", "destination": "/blog/thomas-edison-electric-lighting", "permanent": true },
    { "source": "/blog/radia-perlman-the-engineer-who-solved-one-of-ethernets-biggest-networking-problems", "destination": "/blog/radia-perlman-spanning-tree-protocol", "permanent": true },
    { "source": "/blog/margaret-hamilton-the-software-engineer-whose-code-helped-take-humans-to-the-moon", "destination": "/blog/margaret-hamilton-apollo-software", "permanent": true },
    { "source": "/blog/frances-allen-the-computer-scientist-who-helped-make-software-run-faster", "destination": "/blog/frances-allen-compiler-optimization", "permanent": true },
    { "source": "/blog/automating-customer-support-node-js-whatsapp-and-email-alerts", "destination": "/blog/automate-customer-support-nodejs-whatsapp", "permanent": true },
    { "source": "/blog/building-a-fast-client-booking-portal-with-next-js-and-supabase", "destination": "/blog/client-booking-portal-nextjs-supabase", "permanent": true },
    { "source": "/blog/build-an-interactive-sales-dashboard-with-python-and-streamlit", "destination": "/blog/sales-dashboard-python-streamlit", "permanent": true },
    { "source": "/blog/technology-updates-12-november-2026", "destination": "/blog/tech-news-weekly-digest-nov-2026", "permanent": true },
    { "source": "/blog/yoletech-tech-news-13-november-2026", "destination": "/blog/tech-news-weekly-digest-nov-2026", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/sitemap.xml", "destination": "/api/blog-page?sitemap=1" },
    { "source": "/rss.xml", "destination": "/api/blog-page?rss=1" },
    { "source": "/feed.xml", "destination": "/api/blog-page?rss=1" },
    { "source": "/feed", "destination": "/api/blog-page?rss=1" },
    { "source": "/blog/rss.xml", "destination": "/api/blog-page?rss=1" },
    { "source": "/blog/feed", "destination": "/api/blog-page?rss=1" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/admin/", "destination": "/api/index.js" },
    { "source": "/admin/index.html", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/blog-page?route=/" },
    { "source": "/portfolio", "destination": "/api/blog-page?route=/portfolio" },
    { "source": "/blog", "destination": "/api/blog-page?route=/blog" },
    { "source": "/blog/(.*)", "destination": "/api/blog-page?slug=$1" },
    { "source": "/about", "destination": "/api/blog-page?route=/about" },
    { "source": "/services", "destination": "/api/blog-page?route=/services" },
    { "source": "/dashboard", "destination": "/api/blog-page?route=/dashboard" },
    { "source": "/testimonials", "destination": "/api/blog-page?route=/testimonials" },
    { "source": "/contact", "destination": "/api/blog-page?route=/contact" },
    { "source": "/learn", "destination": "/api/blog-page?route=/learn" },
    { "source": "/learn/", "destination": "/api/blog-page?route=/learn" },
    { "source": "/privacy", "destination": "/api/blog-page?route=/privacy" },
    { "source": "/terms", "destination": "/api/blog-page?route=/terms" },
    { "source": "/cookies", "destination": "/api/blog-page?route=/cookies" },
    { "source": "/learn/dashboard", "destination": "/api/blog-page?route=/learn/dashboard" },
    { "source": "/learn/dashboard/", "destination": "/api/blog-page?route=/learn/dashboard" },
    { "source": "/login", "destination": "/api/blog-page?route=/login" },
    { "source": "/register", "destination": "/api/blog-page?route=/register" },
    { "source": "/portal", "destination": "/api/blog-page?route=/portal" },
    { "source": "/admin-dashboard", "destination": "/api/blog-page?route=/admin-dashboard" },
    { "source": "/(.*)", "destination": "/api/blog-page?route=/$1" }
  ]
}
