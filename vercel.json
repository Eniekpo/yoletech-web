{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{content/**,server/**,public/**}"
    },
    "api/blog-page.js": {
      "includeFiles": "{content/**,server/**,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/(.*)", "destination": "/api/blog-page?slug=$1" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/testimonials", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/portal", "destination": "/index.html" },
    { "source": "/admin-dashboard", "destination": "/index.html" }
  ]
}
